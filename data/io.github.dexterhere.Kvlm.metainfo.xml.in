<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<component type="desktop-application">
  <id>io.github.dexterhere.Kvlm</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Local AI Workstation</name>
  <summary>Explore hardware fit and local AI runtime performance</summary>
  <developer id="io.github.dexterhere">
    <name>Local AI Workstation contributors</name>
  </developer>
  <url type="homepage">https://github.com/dexterhere/kvlm</url>
  <url type="bugtracker">https://github.com/dexterhere/kvlm/issues</url>
  <description>
    <p>Local AI Workstation explains whether a local model fits your computer's memory, shows
    the inference runtimes you already run, and measures them with quick, explicit benchmarks.</p>
    <p>It can browse the public Hugging Face GGUF catalog, download models you choose, and manage
    a llama.cpp server it installs and owns. LM Studio, vLLM and Ollama are only read, never
    started, stopped or changed.</p>
    <p>Nothing runs in the background and nothing is sent anywhere unless you press a button.
    There is no telemetry, no account and no need for administrator rights.</p>
  </description>
  <launchable type="desktop-id">io.github.dexterhere.Kvlm.desktop</launchable>
  <provides>
    <binary>local-ai-workstation</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.2" date="2026-10-27" type="development">
      <description><p>Application ID change, installer script, first-run setup guide and measured runtime benchmarks.</p></description>
    </release>
    <release version="0.1.1" date="2026-10-27" type="development">
      <description>
        <p>Beta pre-release for testing. Built from source; hardware, GNOME-session and screen-reader validation are still in progress.</p>
      </description>
    </release>
  </releases>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
</component>
